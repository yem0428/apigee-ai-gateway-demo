<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>EV-RequestDetails</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
      <Step>
        <Name>VA-VerifyAPIKey</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
      <Step>
        <Name>AM-RemoveAuthorization</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="OptionsPreFlight">
      <Request>
        <Step>
          <Name>CORS-Headers</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>request.verb == "OPTIONS" AND request.header.origin != null AND request.header.Access-Control-Request-Method != null</Condition>
    </Flow>
    <Flow name="vertex-ai-flow">
      <Description/>
      <Request>
        <Step>
          <Condition>(flow.emailId = null) or (flow.emailId = "")</Condition>
          <Name>RF-MissingUserEmail</Name>
        </Step>
        <Step>
          <Name>SUP-UserPrompt</Name>
          <Condition>flow.userPrompt != null</Condition>
        </Step>
        <Step>
          <Name>LTQ-TokenEnforce</Name>
        </Step>
        <Step>
          <Condition>request.header.use-cache is true</Condition>
          <Name>SCL-Semantic-Cache-Lookup</Name>
        </Step>
      </Request>
      <Response>
      </Response>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow">
    <Request>
      <Step>
        <Name>CORS-Headers</Name>
      </Step>
    </Request>
    <Response/>
  </PostFlow>
  <PostClientFlow>
    <Response>
      <Step>
        <Name>ML-CloudLogging</Name>
      </Step>
    </Response>
  </PostClientFlow>
  <HTTPProxyConnection>
    <BasePath>/vertexai/v1</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
