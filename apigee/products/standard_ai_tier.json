{
  "name": "Standard AI Tier",
  "displayName": "Standard AI Tier",
  "approvalType": "auto",
  "environments": [
    "dev",
    "prod"
  ],
  "attributes": [
    {
      "name": "access",
      "value": "private"
    },
    {
      "name": "tier",
      "value": "standard"
    },
    {
      "name": "description",
      "value": "Generic standard tier for lightweight models and auto-routing (Gemini Flash, Flash-Lite, Haiku)"
    }
  ],
  "llmOperationGroup": {
    "operationConfigs": [
      {
        "apiSource": "ai-gateway-v1",
        "llmOperations": [
          {
            "resource": "/auto*",
            "methods": [
              "POST"
            ],
            "model": "auto"
          },
          {
            "resource": "/models/auto*",
            "methods": [
              "POST"
            ],
            "model": "auto"
          }
        ],
        "llmTokenQuota": {
          "limit": "2000",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "ai-gateway-v1",
        "llmOperations": [
          {
            "resource": "/models/gemini-2.5-flash*",
            "methods": [
              "POST"
            ],
            "model": "gemini-2.5-flash"
          },
          {
            "resource": "/v1/projects/*/locations/*/publishers/google/models/gemini-2.5-flash*",
            "methods": [
              "POST"
            ],
            "model": "gemini-2.5-flash"
          }
        ],
        "llmTokenQuota": {
          "limit": "100",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "ai-gateway-v1",
        "llmOperations": [
          {
            "resource": "/models/gemini-3.1-flash-lite*",
            "methods": [
              "POST"
            ],
            "model": "gemini-3.1-flash-lite"
          },
          {
            "resource": "/v1/projects/*/locations/*/publishers/google/models/gemini-3.1-flash-lite*",
            "methods": [
              "POST"
            ],
            "model": "gemini-3.1-flash-lite"
          }
        ],
        "llmTokenQuota": {
          "limit": "2000",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "ai-gateway-v1",
        "llmOperations": [
          {
            "resource": "/models/gemini-3-flash*",
            "methods": [
              "POST"
            ],
            "model": "gemini-3-flash"
          },
          {
            "resource": "/v1/projects/*/locations/*/publishers/google/models/gemini-3-flash*",
            "methods": [
              "POST"
            ],
            "model": "gemini-3-flash"
          }
        ],
        "llmTokenQuota": {
          "limit": "2000",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "ai-gateway-v1",
        "llmOperations": [
          {
            "resource": "/models/claude-3-5-haiku*",
            "methods": [
              "POST"
            ],
            "model": "claude-3-5-haiku"
          },
          {
            "resource": "/v1/projects/*/locations/*/publishers/anthropic/models/claude-3-5-haiku*",
            "methods": [
              "POST"
            ],
            "model": "claude-3-5-haiku"
          }
        ],
        "llmTokenQuota": {
          "limit": "2000",
          "interval": "1",
          "timeUnit": "minute"
        }
      }
    ]
  }
}
