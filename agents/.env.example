ENVIRONMENT=development
APIGEE_AI_GATEWAY_URL=https://my-apigee-org-eval.apigee.net/ai
APIGEE_TOOLS_GATEWAY_URL=https://my-apigee-org-eval.apigee.net/tools
APIGEE_API_KEY=CHANGEME
# Headless caller identity. The AI Gateway reads the `email` claim from this JWT;
# x-apikey alone gets a 401. Leave unset when the end user's token is forwarded to /chat.
APIGEE_IDENTITY_TOKEN=
DEFAULT_MODEL=gemini-3.1-flash-lite
