# Apigee AI & Tools Gateway Unified Credentials Template
# Copy this file to .env and replace placeholder values with your Apigee keys

VITE_DEFAULT_ENV=prod

VITE_ADMIN_API_KEY=your_unified_admin_api_key_here
VITE_ADMIN_USER_EMAIL=admin@example.com

VITE_SALES_API_KEY=your_unified_sales_agent_api_key_here
VITE_SALES_AGENT_EMAIL=sales.agent@example.com

VITE_LOANS_API_KEY=your_unified_loans_agent_api_key_here
VITE_LOANS_AGENT_EMAIL=loans.agent@example.com

VITE_SSO_USER_EMAIL=demo.user@example.com

# Which deployed environment `npm run test:live` exercises: dev | prod.
# Keep this on dev. The live suite is not read-only - it burns token quota,
# debits the prepaid budget and seeds the shared semantic cache - so pointing
# it at prod degrades the environment used for customer demos.
# To target prod deliberately: npm run test:live:prod
TEST_ENV=dev
